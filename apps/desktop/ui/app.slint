import { Button, LineEdit, ComboBox, CheckBox, ScrollView } from "std-widgets.slint";
// ProfilePort — main window (dashboard prototype).

import { Theme } from "theme.slint";
import { Label } from "components.slint";

export { Theme }

export component AppWindow inherits Window {
    title: "ProfilePort";
    preferred-width: 1040px;
    preferred-height: 760px;
    min-width: 820px;
    min-height: 620px;
    background: Theme.window-bg;
    default-font-family: Theme.font-family;

    in property <string> version;
    in property <[string]> profiles;
    in property <[string]> packages;
    in-out property <int> selected-package: 0;
    in-out property <int> target-profile: 0;
    in-out property <int> selected-profile: 0;
    in-out property <int> page: 0;
    in-out property <string> source;
    in-out property <string> drive;
    in-out property <string> ticket;
    in-out property <string> package-path;
    in-out property <string> target-path;
    in-out property <string> code-entry;
    in-out property <bool> allow-cloud: false;
    in property <bool> busy: false;
    in property <bool> awaiting-confirmation: false;
    in property <string> displayed-code;
    in property <string> status: "Choose a task to begin.";
    in property <string> details;
    callback profile-selected(int);
    callback target-selected(int);
    callback package-selected(int);
    callback scan-drive;
    callback cancel-preparation;
    callback prepare-backup;
    callback confirm-backup;
    callback resume-backup;
    callback verify-backup;
    callback restore-backup;

    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 232px;
            background: Theme.sidebar-bg;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Label { text: "ProfilePort"; font-size: 22px; font-weight: 700; }
                Label { text: "Move files with confidence"; color: Theme.text-secondary; font-size: 12px; }
                Rectangle { height: 18px; }
                Button { text: "Back up"; enabled: !root.busy; clicked => { root.page = 0; } }
                Button { text: "Verify or restore"; enabled: !root.busy; clicked => { root.page = 1; } }
                Rectangle { vertical-stretch: 1; }
                Label { text: "Offline · v" + root.version; color: Theme.text-tertiary; font-size: 12px; }
            }
        }
        ScrollView {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 32px;
                spacing: 12px;
                Label { text: root.page == 0 ? "Back up a PC" : "Verify or restore"; font-size: 28px; font-weight: 700; }
                Label {
                    text: root.page == 0 ? "Create an encrypted backup on a connected drive." : "Unlock a backup, check it, or restore it to a profile.";
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                if root.page == 0: VerticalLayout {
                    spacing: 8px;
                    Label { text: "User profile"; font-weight: 600; }
                    ComboBox { model: root.profiles; current-index <=> root.selected-profile; enabled: !root.busy && !root.awaiting-confirmation; selected(_) => { root.profile-selected(root.selected-profile); } }
                    Label { text: "Source folder"; font-weight: 600; }
                    LineEdit { text <=> root.source; placeholder-text: "C:\\Users\\name"; enabled: !root.busy && !root.awaiting-confirmation; }
                    Label { text: "USB drive root"; font-weight: 600; }
                    LineEdit { text <=> root.drive; placeholder-text: "E:\\"; enabled: !root.busy && !root.awaiting-confirmation; }
                    Label { text: "Ticket number"; font-weight: 600; }
                    LineEdit { text <=> root.ticket; enabled: !root.busy && !root.awaiting-confirmation; }
                    Label { text: "The whole profile is copied, excluding cache and temporary folders. Cloud-only files and inaccessible files may be skipped."; wrap: word-wrap; color: Theme.text-secondary; }
                    if !root.awaiting-confirmation: Button { text: "Prepare backup"; enabled: !root.busy; clicked => { root.prepare-backup(); } }
                    if root.awaiting-confirmation: VerticalLayout {
                        spacing: 8px;
                        Label { text: "Write this code on the device tag"; font-weight: 700; }
                        Label { text: root.displayed-code; font-size: 24px; font-weight: 700; }
                        Label { text: "Without this code the backup cannot be restored or resumed. Do not put it in the ticket system."; wrap: word-wrap; color: Theme.text-secondary; }
                        LineEdit { text <=> root.code-entry; placeholder-text: "Type the code back"; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Confirm code and start backup"; enabled: !root.busy; clicked => { root.confirm-backup(); } }
                            Button { text: "Cancel"; enabled: !root.busy; clicked => { root.cancel-preparation(); } }
                        }
                    }
                }
                if root.page == 1: VerticalLayout {
                    spacing: 8px;
                    Label { text: "USB drive root"; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit { text <=> root.drive; placeholder-text: "E:\\"; enabled: !root.busy; horizontal-stretch: 1; }
                        Button { text: "Find backups"; enabled: !root.busy; clicked => { root.scan-drive(); } }
                    }
                    if root.packages.length > 0: ComboBox { model: root.packages; current-index <=> root.selected-package; enabled: !root.busy; selected(_) => { root.package-selected(root.selected-package); } }
                    Label { text: "Backup folder"; font-weight: 600; }
                    LineEdit { text <=> root.package-path; placeholder-text: "Path to the backup folder on the USB drive"; enabled: !root.busy; }
                    Label { text: "Transfer code"; font-weight: 600; }
                    LineEdit { text <=> root.code-entry; placeholder-text: "Code from the device tag"; enabled: !root.busy; }
                    Label { text: "Destination profile"; font-weight: 600; }
                    ComboBox { model: root.profiles; current-index <=> root.target-profile; enabled: !root.busy; selected(_) => { root.target-selected(root.target-profile); } }
                    Label { text: "Destination profile folder"; font-weight: 600; }
                    LineEdit { text <=> root.target-path; placeholder-text: "C:\\Users\\name"; enabled: !root.busy; }
                    CheckBox { text: "Allow restore to cloud-synced folders (files may be uploaded)"; checked <=> root.allow-cloud; enabled: !root.busy; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Resume backup"; enabled: !root.busy; clicked => { root.resume-backup(); } }
                        Button { text: "Verify backup"; enabled: !root.busy; clicked => { root.verify-backup(); } }
                        Button { text: "Restore files"; enabled: !root.busy; clicked => { root.restore-backup(); } }
                    }
                    Label { text: "Existing files are not overwritten. Restore checks written files by default."; wrap: word-wrap; color: Theme.text-secondary; }
                }
                Rectangle { height: 1px; background: Theme.border; }
                Label { text: root.status; font-size: 16px; font-weight: 700; wrap: word-wrap; }
                Label { text: root.details; color: Theme.text-secondary; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
